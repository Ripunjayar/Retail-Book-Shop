# Example OAuth configuration
# Copy this file to .env and replace with your real values.
VITE_OAUTH_PROVIDER=google
VITE_OAUTH_CLIENT_ID=your-google-client-id
VITE_OAUTH_CLIENT_SECRET=your-google-client-secret
VITE_OAUTH_REDIRECT_URI=http://localhost:5173

# Optional: if you later add a backend auth service
# VITE_API_BASE_URL=http://localhost:3000
